# Copy to .env.local for local Vite. Never commit real secrets.
# Lovable Cloud injects VITE_* at preview/publish time.

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# --- Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets) ---
# APP_URL=https://shortwork.lovable.app
# OAUTH_STATE_SECRET=
# TOKEN_ENCRYPTION_KEY=
# OAUTH_FRONTEND_CALLBACK=false

# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=

# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# INSTAGRAM_CLIENT_ID=
# INSTAGRAM_CLIENT_SECRET=

# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=

# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# THREADS_CLIENT_ID=
# THREADS_CLIENT_SECRET=
